<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========== EXEMPLAR ========== -->
    <record id="view_woemployee_form" model="ir.ui.view">
        <field name="name">fabrica2.woemployee.form</field>
        <field name="model">fabrica2.woemployee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="workorder" string="Ordem de Trabalho"/>
                        <field name="employee" string="Funcionário"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_woemployee_list" model="ir.ui.view">
        <field name="name">fabrica2.woemployee.list</field>
        <field name="model">fabrica2.woemployee</field>
        <field name="arch" type="xml">
         <list >
                <field name="state" 
                    widget="badge" 
                    decoration-warning="state == 'progress'" 
                    decoration-success="state == 'done'" 
                    decoration-danger="state == 'cancel'" 
                    decoration-info="state not in ('progress', 'done', 'cancel')"
                    />

                <field name="workorder" string="Ordem de Trabalho"/>
                <field name="employee" string="Funcionário"/>
            </list>
        </field>
    </record>


    <record id="action_woemployee" model="ir.actions.act_window">
        <field name="name">Ordens de Trabalho</field>
        <field name="res_model">fabrica2.woemployee</field>
        <field name="view_mode">list,form</field>
    </record>

              
</odoo>
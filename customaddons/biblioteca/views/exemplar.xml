<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========== EXEMPLAR ========== -->
    <record id="view_exemplar_form" model="ir.ui.view">
        <field name="name">biblioteca.exemplar.form</field>
        <field name="model">biblioteca.exemplar</field>
        <field name="arch" type="xml">
            <form>
              <notebook>
                <page string="Geral">
                    <group>
                        <field name="livro" string="Título"/>
                        <field name="numero" string="Exemplar"/>
                        <field name="localizacao" string="Localização"/>
                    </group>
                </page>
              </notebook>
            </form>
        </field>
    </record>

    <record id="view_exemplar_list" model="ir.ui.view">
        <field name="name">biblioteca.exemplar.list</field>
        <field name="model">biblioteca.exemplar</field>
        <field name="arch" type="xml">
         <list default_group_by="livro" >
                <field name="numero_str" string="Exemplar"/>
         
                <field name="titulo_display" string="Título"/>
                <field name="autor_display" string="Autor"/>
         
                <field name="localizacao" string="Localização"/>
            </list>
        </field>
    </record>

    <record id="view_exemplar_kanban" model="ir.ui.view">
        <field name="name">biblioteca.exemplar.kanban</field>
        <field name="model">biblioteca.exemplar</field>
        <field name="arch" type="xml">
            <kanban>
                <templates >
                    <t t-name="card">
                       <div style="font-weight: bold">
                           <field name="titulo_display"/>
                    </div>
                       <div style="font-style: italic">
                           <field name="autor_display"/>
                    </div>
                    <field name="numero_str"/>
                    <field name="localizacao" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_exemplar" model="ir.actions.act_window">
        <field name="name">Exemplares</field>
        <field name="res_model">biblioteca.exemplar</field>
        <field name="view_mode">list,kanban,form</field>
    </record>


</odoo>
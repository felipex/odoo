<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========== AUTOR ========== -->
    <record id="view_autor_form" model="ir.ui.view">
        <field name="name">biblioteca.autor.form</field>
        <field name="model">biblioteca.autor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nome do Autor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_autor_tree" model="ir.ui.view">
        <field name="name">biblioteca.autor.tree</field>
        <field name="model">biblioteca.autor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Autor"/>
            </list>
        </field>
    </record>

    <record id="action_autor" model="ir.actions.act_window">
        <field name="name">Autores</field>
        <field name="res_model">biblioteca.autor</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ========== EDITORA ========== -->
    <record id="view_editora_form" model="ir.ui.view">
        <field name="name">biblioteca.editora.form</field>
        <field name="model">biblioteca.editora</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nome da Editora"/>
                        <field name="cidade" string="Cidade"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_editora_tree" model="ir.ui.view">
        <field name="name">biblioteca.editora.tree</field>
        <field name="model">biblioteca.editora</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Editora"/>
                <field name="cidade" string="Cidade"/>
            </list>
        </field>
    </record>

    <record id="action_editora" model="ir.actions.act_window">
        <field name="name">Editoras</field>
        <field name="res_model">biblioteca.editora</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ========== MENUS ========== -->
    <menuitem id="menu_principal" name="Biblioteca" sequence="10"/>
    
    <menuitem id="submenu_autores" name="Autores" parent="menu_principal"/>
    <menuitem id="menu_autores" name="Lista de Autores" parent="submenu_autores" action="action_autor"/>
    
    <menuitem id="submenu_editoras" name="Editoras" parent="menu_principal"/>
    <menuitem id="menu_editoras" name="Lista de Editoras" parent="submenu_editoras" action="action_editora"/>
</odoo>
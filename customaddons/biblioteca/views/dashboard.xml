<odoo>
    <!-- View Kanban para Dashboard -->
    <record id="view_library_dashboard_kanban" model="ir.ui.view">
        <field name="name">Library Dashboard</field>
        <field name="model">biblioteca.livro</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- Card 1: Total de exemplares -->
                        <div class="oe_kanban_card">
                            <div class="o_kanban_primary_left">
                                <div class="o_primary">
                                    <span class="o_kanban_stat_title">
                                        <field name="nome" />
                                    </span>
                                        <span class="o_kanban_stat_value">
                                        <p t-if="exemplares_count== 3" >
                                            <field name="exemplares_count" style="color: red"/>
                                        </p>
                                        <p t-else="">
                                            <field name="exemplares_count"  style="color: blue"/>
                                        </p>
                                    </span>

                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action para o Dashboard -->
    <record id="action_library_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Biblioteca</field>
        <field name="res_model">biblioteca.livro</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_library_dashboard_kanban"/>
    </record>

    <!-- Menu para o Dashboard -->
    <menuitem 
        id="menu_library_dashboard" 
        name="Dashboard" 
        parent="submenu_cadastro" 
        action="action_library_dashboard"
        sequence="5"/>
</odoo>
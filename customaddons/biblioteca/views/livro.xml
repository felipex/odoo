<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========== LIVRO ========== -->
    <record id="view_livro_form" model="ir.ui.view">
        <field name="name">biblioteca.livro.form</field>
        <field name="model">biblioteca.livro</field>
        <field name="arch" type="xml">
            <form>
              <notebook>
                <page string="Geral">
                    <group>
                        <field name="titulo" string="Título"/>
                        <field name="autor" string="Autor"/>
                    </group>
                    <group>
                        <field name="edicao" string="Edição"/>
                        <field name="editora" string="Editora"/>
                    </group>
                    <group>
                        <field name="assunto_ids" string="Assuntos"/>
                    </group>

                </page>
                  
                  <page string="Sinopse">
                  <group>
                    <field name="sinopse" string="Sinopse" />
                    </group>
                  </page>
              </notebook>
            </form>
        </field>
    </record>

    <record id="view_livro_list" model="ir.ui.view">
        <field name="name">biblioteca.livro.list</field>
        <field name="model">biblioteca.livro</field>
        <field name="arch" type="xml">
         <list>
                <field name="titulo" string="Título"/>
                <field name="edicao_str" string="Edição"/>
            </list>
        </field>
    </record>
    <record id="view_livro_kanban" model="ir.ui.view">
        <field name="name">biblioteca.livro.kanban</field>
        <field name="model">biblioteca.livro</field>
        <field name="arch" type="xml">
            <kanban>
                <templates >
                    <t t-name="card">
                       <div style="font-weight: bold">
                           <field name="titulo"/>
                    </div>
                    <field name="autor"/>
                    <field name="edicao_str" />
                    <div>
                        <span>#Exemplares: </span>
                        <field name="exemplares_count" />
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_livro" model="ir.actions.act_window">
        <field name="name">Livros</field>
        <field name="res_model">biblioteca.livro</field>
        <field name="view_mode">list,kanban,form</field>
    </record>


</odoo>
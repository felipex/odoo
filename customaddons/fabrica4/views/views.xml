<odoo>
  <data>
  <record model="ir.ui.view" id="fabrica4.view_workorder_form">
    <field name="name">fabrica4.view_workorder_form</field>
    <field name="model">fabrica4.employee_workorder</field>
    <field name="arch" type="xml">
      <form>
      <sheet>
      <group>
        <field name="employee_id" string="Funcionário"/>
        <field name="workorder_id" string="Ordem de Trabalho"/>
        <field name="planned_start_date" string="Data de Início Planejada"/>
        <field name="start_date" string="Data de Início"/>
        <field name="end_date" string="Data de Término"/>
      </group>
      </sheet>
      </form>
    </field>
  </record> 

  <record model="ir.ui.view" id="fabrica4.view_workorder_list">
    <field name="name">fabrica4.view_workorder_list</field>
    <field name="model">fabrica4.employee_workorder</field>
    <field name="arch" type="xml">
      <list>
        <field name="employee_id" string="Funcionário"/>
        <field name="workorder_id" string="Ordem de Trabalho"/>
        <field name="workcenter_id" string="Centro de Trabalho"/>
        <field name="planned_start_date" string="Data de Início Planejada"/>
        <field name="start_date" string="Data de Início"/>
        <field name="end_date" string="Data de Término"/>
      </list>
    </field>
  </record> 

  <record model="ir.actions.act_window" id="fabrica4.action_workorder">
    <field name="name">fabrica4.action_workorder</field>
    <field name="res_model">fabrica4.employee_workorder</field>
    <field name="view_mode">list,form</field>
  </record> 
<!-- -->

<record model="ir.ui.view" id="fabrica4.view_workorder2_list">
    <field name="name">fabrica4.workorder.tree.inherit</field>
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/> 
    <field name="arch" type="xml">
        <xpath expr="//field[@name='workcenter_id']" position="before">
            <field name="employee_name" string="Atribuída a"/>
            <field name="assigned"/>
            <field name="production_id" string="Ordem de Produção"/>
        </xpath>
    </field>
</record>

<record model="ir.ui.view" id="fabrica4.view_workorder2_form">
    <field name="name">fabrica4.workorder.form.inherit</field>
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/> 
    <field name="arch" type="xml">
        <xpath expr="//field[@name='workcenter_id']" position="before">
            <field name="employee_name" string="Atribuída a"/>  
        </xpath>
    </field>
</record>


  <record model="ir.actions.act_window" id="fabrica4.action_workorder2">
    <field name="name">fabrica4.action_workorder2</field>
    <field name="res_model">mrp.workorder</field>
    <field name="view_mode">list,form</field>
  </record> 

    <!-- ========== MENUS ========== -->
    <menuitem id="main_menu" name="Fabricacao-4" sequence="10"/>
    
    <!-- Submenu único "Cadastro" -->
    <menuitem id="submenu_wo" name="Ordens_de_Trabalho4" parent="main_menu"/>
    
    <!-- Opções dentro do submenu Cadastro -->
    <menuitem id="menu_woe" 
              name="Ordens_de_trabalho" 
              action="fabrica4.action_workorder"
              sequence="20"
              parent="main_menu"
              />
    <menuitem id="menu_woex" 
              name="Ordens de trabalho X" 
              action="fabrica4.action_workorder2"
              sequence="30"
              parent="main_menu"
              />


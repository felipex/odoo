<odoo>
    <record id="view_meu_modelo_form" model="ir.ui.view">
        <field name="name">Formulário do Meu Modelo</field>
        <field name="model">meu.modulo.modelo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descricao"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu e Ação -->
    <menuitem id="menu_principal" name="Meu Módulo" sequence="10"/>
    <menuitem id="submenu" name="Submenu" parent="menu_principal"/>
    <record id="acao_meu_modelo" model="ir.actions.act_window">
        <field name="name">Meu Modelo</field>
        <field name="res_model">meu.modulo.modelo</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_meu_modelo" name="Itens" parent="submenu" action="acao_meu_modelo"/>
</odoo>

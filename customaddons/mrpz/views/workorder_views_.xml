<odoo>
  <data>
    
    <record id="view_mrp_workorder_form_quick_edit" model="ir.ui.view">
      <field name="name">mrp.workorder.form.quick.edit</field>
      <field name="model">mrp.workorder</field>
      <field name="arch" type="xml">
        <form string="Editar Funcionário e Data de Início">
          <sheet>
            <group>
                <field name="name" string="Nome da Ordem de Produção" readonly="1"/>
                <field name="workcenter_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
            </group>
            <group>
                <field name="product_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                <field name="qty_production" string="Quantidade" readonly="1"/>
            </group>
            <group>
              <field name="employee_id"/>
              <field name="planned_start_date"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    
    <record id="action_mrp_workorder_quick_edit" model="ir.actions.act_window">
      <field name="name">Editar Funcionário/Data Início</field>
      <field name="res_model">mrp.workorder</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="view_id" ref="view_mrp_workorder_form_quick_edit"/>
        
    </record>
    
        <record id="view_mrp_workorder_form_extended" model="ir.ui.view">
          <field name="name">mrp.workorder.form.extended</field>
          <field name="model">mrp.workorder</field>
          <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
          <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
              <field name="employee_id"/>
              <field name="planned_start_date"/>
            </xpath>
        
        <xpath expr="//div[@class='oe_button_box']" position="inside">
          <button class="oe_stat_button"
                  type="action"
                  name="%(action_mrp_workorder_quick_edit)d"
                  icon="fa-pencil-square-o"
                  string="Editar Rápido"/>
        </xpath>
          </field>
        </record>
    
    
    <record id="mrp_production_workorder_tree_view_inherited" model="ir.ui.view">
      <field name="name">mrp.workorder.list.inherit</field>
      <field name="model">mrp.workorder</field>
      <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='workcenter_id']" position="after">
          <field name="employee_id"/>
          <button name="button_start" type="object" title="Atribui" class="btn-success px-2"
                  invisible="production_state in ('draft', 'done', 'cancel') or working_state == 'blocked' or state in ('done', 'cancel') or is_user_working" icon="fa-play"/>
          
          <field name="planned_start_date"/>
          <button name="%(action_mrp_workorder_quick_edit)d"
                  string="Editar Selecionados"
                  type="action"/>
        </xpath>
        
        
      </field>
    </record>    
    
    
  <record id="action_mrp_workorder" model="ir.actions.act_window">
    <field name="name">Work Order</field>
    <field name="res_model">mrp.workorder</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="mrp_production_workorder_tree_view_inherited"/>
  </record>
    

  </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mrp_workorder_extended_form" model="ir.ui.view">
            <field name="name">mrp.workorder.form.extended</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='workcenter_id']" position="after">
                    
                        <field name="employee_id"/>
                        <field name="effective_start_date"/>
                        <field name="effective_end_date" />
                    
                </xpath>
            </field>
        </record>
        
        <record id="mrp_production_workorder_tree_view_inherited" model="ir.ui.view">
            <field name="name">mrp.workorder.list.inherit</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='workcenter_id']" position="after">
                    <field name="employee_id"/>
                </xpath>

            </field>
        </record> 
        
        <record id="mrp_workorder_kanban_view_state" model="ir.ui.view">
            <field name="name">mrp.workorder.kanban.state</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.workcenter_line_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="default_group_by">employee_id</attribute>
                </xpath>
                <xpath expr="//templates/t[@t-name='card']" position="replace">
                    
                    <t t-name="card" class="">
                        <div>
                            <div style="">
                            <field name="name" class="fw-bolder text-primary"/>
                                <span> - </span>
                                <field name="production_id" />
                            </div>
                            <field name="employee_id" class="fw-bolder"/>
                            <br />
                            <field name="effective_start_date"  />
                            <br />
                            <field name="effective_end_date" />
                            <br />
                            <field name="state" class="ms-1"  widget="badge" 
                               decoration-warning="state == 'progress'" 
                               decoration-success="state == 'done'" 
                               decoration-danger="state == 'cancel'" 
                               decoration-info="state not in ('progress', 'done', 'cancel')" />
                            <div class="o_kanban_record_bottom ">
                                <button name="button_start" type="object" title="Start" class="btn-success px-2"
                                        invisible="production_state in ('draft', 'done', 'cancel') or working_state == 'blocked' or state in ('done', 'cancel') or is_user_working" icon="fa-play"/>
                            </div>
                            
                        </div>
                    </t>
                </xpath>
            </field>
        </record>

        <record id="mrpz.action_mrp_workorder" model="ir.actions.act_window">
            <field name="name">Ordens de Produção (Estendido)</field>
            <field name="res_model">mrp.workorder</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crie sua primeira ordem de produção!
                </p>
            </field>
        </record>  
        
        
        <record id="assign_employee_wizard_form" model="ir.ui.view">
            <field name="name">assign.employee.wizard.form</field>
            <field name="model">assign.employee.wizard</field>
            <field name="arch" type="xml">
                <form string="Selecionar Funcionário">
                    <group>
                        <field name="employee_id"/>
                        <field name="effective_start_date" widget="datetime"/>
                        <field name="workorder_ids" widget="many2many_tags"/>
                        <button name="action_assign_employee" string="Atribuir" type="object" class="oe_highlight"/>
                    </group>
                    <footer>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <record id="mrp_workorder_extended_tree_with_assign_employee" model="ir.ui.view">
            <field name="name">mrp.workorder.tree.extended.assign.employee</field>
            <field name="model">assign.employee.wizard</field>
            <field name="arch" type="xml">
                <list>
                    <field name="employee_id"/>
                    <field name="workorder_ids" widget="many2many_tags"/>
                </list>
                
            </field>
        </record>

    </data>
</odoo>
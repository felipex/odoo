<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extended Workorder Tree View -->
    <record id="view_mrp_workorder_extended_tree" model="ir.ui.view">
        <field name="name">mrp.workorder.extended.tree</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="assigned_employee_id" optional="show"/>
                <field name="assignment_status" optional="show" widget="badge" 
                       decoration-info="assignment_status == 'assigned'"
                       decoration-warning="assignment_status == 'in_progress'" 
                       decoration-success="assignment_status == 'completed'"
                       decoration-muted="assignment_status == 'unassigned'"/>
            </field>
            <field name="production_id" position="after">
                <field name="date_planned_start_extended" optional="show"/>
                <field name="date_actual_start" optional="show"/>
                <field name="date_actual_end" optional="show"/>
                <field name="duration_planned_vs_actual" optional="hide" widget="float_time"/>
            </field>
        </field>
    </record>

    <!-- Extended Workorder Form View -->
    <record id="view_mrp_workorder_extended_form" model="ir.ui.view">
        <field name="name">mrp.workorder.extended.form</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">         
            <!-- Add assignment information at the top -->
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_assign_employee" type="object" 
                            class="oe_stat_button" icon="fa-user" title="Assign Employee"
                            invisible="assigned_employee_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Assign</span>
                            <span class="o_stat_text">Employee</span>
                        </div>
                    </button>
                    <button name="action_assign_employee" type="object" 
                            class="oe_stat_button" icon="fa-user-check"
                            invisible="not assigned_employee_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="assigned_employee_id" widget="name_get"/>
                            </span>
                            <span class="o_stat_text">Assigned</span>
                        </div>
                    </button>
                </div>
            </xpath>

            <!-- Add assignment and timing group -->
            <xpath expr="//sheet/group[1]" position="after">
                <group name="assignment_timing" string="Assignment &amp; Timing">
                    <group>
                        <field name="assigned_employee_id" options="{'no_create': True}"/>
                        <field name="assignment_status" widget="badge"/>
                        <field name="date_planned_start_extended"/>
                    </group>
                    <group>
                        <field name="date_actual_start" readonly="1"/>
                        <field name="date_actual_end" readonly="1"/>
                        <field name="duration_planned_vs_actual" widget="float_time" 
                               invisible="duration_planned_vs_actual == 0.0"/>
                    </group>
                </group>
            </xpath>
            
            <!-- Enhance the header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_start_workorder_extended" type="object" 
                        string="Start Work" class="oe_highlight"
                        invisible="state != 'ready' or date_actual_start"/>
                <button name="action_finish_workorder_extended" type="object" 
                        string="Finish Work" class="oe_highlight"
                        invisible="not date_actual_start or date_actual_end"/>
            </xpath>
        </field>
    </record>

    <!-- Quick Assignment Form View -->
    <record id="view_mrp_workorder_assignment_form" model="ir.ui.view">
        <field name="name">mrp.workorder.assignment.form</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <form string="Assign Workorder">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="product_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="workcenter_id" readonly="1"/>
                            <field name="operation_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_employee_id" options="{'no_create': True}" 
                                   placeholder="Select an employee..." required="1"/>
                            <field name="date_planned_start_extended" 
                                   placeholder="When should this start?"/>
                        </group>
                    </group>
                    <group string="Current Status">
                        <field name="assignment_status" widget="badge" readonly="1"/>
                        <field name="date_actual_start" readonly="1" 
                               invisible="not date_actual_start"/>
                        <field name="date_actual_end" readonly="1"
                               invisible="not date_actual_end"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Assign" name="action_assign_employee" type="object" 
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Kanban View for Workorder Assignment -->
    <record id="view_mrp_workorder_assignment_kanban" model="ir.ui.view">
        <field name="name">mrp.workorder.assignment.kanban</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban default_group_by="assignment_status" class="o_kanban_small_column">
                <field name="assigned_employee_id"/>
                <field name="assignment_status"/>
                <field name="date_planned_start_extended"/>
                <field name="date_actual_start"/>
                <field name="date_actual_end"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="product_id"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="workcenter_id"/>
                                    <br/>
                                    <t t-if="record.assigned_employee_id.raw_value">
                                        <i class="fa fa-user"/> <field name="assigned_employee_id"/>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted">
                                            <i class="fa fa-user-o"/> Unassigned
                                        </span>
                                    </t>
                                    <br/>
                                    <t t-if="record.date_planned_start_extended.raw_value">
                                        <i class="fa fa-calendar">tt</i> <field name="date_planned_start_extended"/>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" 
                                               options="{'classes': {'ready': 'info', 'progress': 'warning', 'done': 'success'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="!record.assigned_employee_id.raw_value">
                                            <button name="action_assign_employee" type="object" 
                                                    class="btn btn-primary btn-sm">
                                                Assign
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_manage_button_section">
                                <a class="o_kanban_edit" href="#" role="button">
                                    <i class="fa fa-edit" role="img" aria-label="Edit" title="Edit"/>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for Workorder Assignment Dashboard -->
    <record id="action_mrp_workorder_assignment" model="ir.actions.act_window">
        <field name="name">Workorder Assignment</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_mrp_workorder_assignment_kanban"/>
        <field name="context">{}</field>
        <field name="domain">[('state', 'in', ['ready', 'progress'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No workorders to assign!
            </p>
            <p>
                Create manufacturing orders to generate workorders that can be assigned to employees.
            </p>
        </field>
    </record>

</odoo>
